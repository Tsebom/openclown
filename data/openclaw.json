{
  "gateway": {
    "mode": "local",
    "bind": "lan"
  },
  "models": {
    "mode": "merge",
    "providers": {
      "wormsoft": {
        "baseUrl": "https://ai.wormsoft.ru/api/gpt",
        "apiKey": "${WORMSOFT_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "wormsoft/code/high",
            "name": "Code High"
          },
          {
            "id": "deepseek/deepseek-v4.1-flash:fast",
            "name": "DeepSeek"
          },
          {
            "id": "xiaomi/mimo-v2.6-pro",
            "name": "Mimo 2.6"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "wormsoft/wormsoft/code/high"
      }
    }
  }
}

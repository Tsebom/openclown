# --- OpenClaw Server Settings ---
# Host port where the Gateway / Web Control UI is published (the container
# always listens internally on port 18789)
OPENCLAW_PORT=18789
# Auth token for the Web Control UI and the Gateway API. Open the dashboard
# in a browser and paste this token into Settings.
# If left empty, a random token will be generated and printed in the logs
# (docker logs openclaw-standalone).
OPENCLAW_GATEWAY_TOKEN=
# Optional: primary model for the agent (any of the Wormsoft models)
# OPENCLAW_MODEL=wormsoft/code/medium
# Optional: extra Control UI allowed origins for browser access from other
# machines, comma-separated, e.g. "https://claw.example.com,http://192.168.1.10:18789"
# OPENCLAW_CONTROL_UI_ORIGINS=

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
# Who is allowed to DM the bot: a comma-separated list of NUMERIC Telegram
# user IDs. Everyone else is ignored (dmPolicy=allowlist).
# Find your user ID: DM the bot and read the pairing reply, or
# curl "https://api.telegram.org/bot<TOKEN>/getUpdates" and read from.id
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# --- API Keys ---
# Wormsoft (OpenAI-compatible) provider key used by the agent model
WORMSOFT_API_KEY=your-wormsoft-key-here

# === Обязательно ===

# Токен Gateway — нужен, чтобы войти в веб-панель из браузера
# (вставляете его в Settings при открытии http://127.0.0.1:18789/).
# Сгенерировать: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-secret-gateway-token-here

# === Доступ из браузера ===

# Куда привязать порт Gateway на хосте:
#   127.0.0.1 — доступ только с этой машины (по умолчанию, безопаснее)
#   0.0.0.0   — доступ с других машин в сети (защитите порт файрвоалом!)
OPENCLAW_BIND=127.0.0.1
OPENCLAW_PORT=18789

# === Базовый образ для Dockerfile (необязательно) ===

# Образ собирается из Dockerfile (юзер agent, UID 1050) на базе одного из
# официальных образов — используйте только их, не неофициальные зеркала:
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# OPENCLAW_IMAGE=openclaw/openclaw:latest
# Базовый со встроенным Chromium (инструмент браузера в песочнице):
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest-browser
# Конкретная версия (рекомендуется для прода):
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.11.4

# === Ключи провайдеров моделей (необязательно) ===

# Хоть один — иначе агент не сможет отвечать.
# Либо задать здесь, либо интерактивно: docker compose run --rm --no-deps
# --entrypoint node openclaw-gateway dist/index.js onboard --mode local
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
WORMSOFT_API_KEY=your-wormsoft-key-here

# === Telegram-бот (канал OpenClaw) ===

# Токен бота от @BotFather (вид: 123456789:AA...).
# Подставляется в channels.telegram.botToken в data/openclaw.json.
TELEGRAM_BOT_TOKEN=paste-telegram-bot-token-here

# Белый список user id для личных сообщений (dmPolicy=allowlist):
# ЧИСЛОВОЙ id Telegram, один id в одной переменной. До 4 пользователей.
# Как узнать: напишите боту и посмотрите from.id в `docker compose logs -f`,
# либо curl "https://api.telegram.org/bot<TOKEN>/getUpdates" (поле chat.id).
#
# Если пользователей меньше 4:
#   - либо заполните только нужные переменные, а в оставшихся оставьте
#     плейсхолдеры (нечисловые записи allowFrom игнорируются);
#   - либо удалите лишние переменные здесь И соответствующие записи
#     "${TELEGRAM_ALLOW_FROM_N}" в channels.telegram.allowFrom
#     (data/openclaw.json) — переменная без записи в конфиге не нужна,
#     а запись без переменной уронит Gateway (пустая ${VAR} = ошибка загрузки).
TELEGRAM_ALLOW_FROM=paste-your-telegram-user-id-here
TELEGRAM_ALLOW_FROM_2=paste-telegram-user-id-2-here
TELEGRAM_ALLOW_FROM_3=paste-telegram-user-id-3-here
TELEGRAM_ALLOW_FROM_4=paste-telegram-user-id-4-here

# === Разное (необязательно) ===

# TZ=Europe/Moscow
